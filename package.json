{
  "name": "no-spoil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npx vercel dev --listen 5173",
    "build": "tsc -b && vite build && npm run performance:check-bundles && npm run security:scan-dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test --config=playwright.cloud.config.ts",
    "test:e2e:pwa": "playwright test --config=playwright.production.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "verify:cloud": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/verify-cloud-foundation.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "test:load": "tsx scripts/load-smoke.ts",
    "security:scan-dist": "tsx scripts/scan-build-secrets.ts",
    "performance:check-bundles": "tsx scripts/check-bundle-budgets.ts",
    "typecheck": "tsc --noEmit",
    "verify:release": "npm run typecheck && npm run lint && npm run test:run && npm run build && npm run verify:migrations && npm run test:e2e && npm run test:e2e:pwa && npm audit --audit-level=high",
    "verify:release:cloud": "npm run verify:release && npm run verify:cloud && npm run test:e2e:cloud",
    "deploy:vercel": "npm run verify:release && npx vercel --prod"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/dm-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.110.5",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
