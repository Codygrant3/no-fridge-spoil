# No Fridge Spoil - Environment Variables
# Copy this file to .env.local and fill in your project values.

# Supabase browser configuration (public values)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase server configuration. Never add the secret key to a VITE_ variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key

# Random secrets used by server-side abuse protection and scheduled cleanup.
# Generate each independently with at least 32 random bytes.
RATE_LIMIT_SALT=replace_with_a_long_random_value
CRON_SECRET=replace_with_a_different_long_random_value

# Azure Document Intelligence receipt OCR (server-side only)
# Create a Document Intelligence resource, then add both values to Vercel.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key_here
# Keep the prebuilt model until a consented, retailer-specific training set has been validated.
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-receipt
# Set true only after privacy review and acceptance testing for a custom model.
AZURE_CUSTOM_RECEIPT_MODEL_APPROVED=false
# Set this from the current price for your Azure region/tier so customer cost reports are accurate.
AZURE_DOCUMENT_INTELLIGENCE_COST_PER_PAGE_USD=0.01

# Receipt OCR routing and hard budget controls. All values are server-side.
RECEIPT_OCR_PROVIDER=azure
RECEIPT_OCR_FALLBACK_PROVIDER=mistral
RECEIPT_OCR_CLOUD_FALLBACK_ENABLED=false
RECEIPT_OCR_REQUIRE_USER_CONSENT=true
RECEIPT_OCR_MONTHLY_PAGE_BUDGET=10000
RECEIPT_OCR_MONTHLY_USD_BUDGET=100
RECEIPT_WORKER_BATCH_SIZE=5

# Optional supplemental provider. Keep disabled until the same receipt corpus
# has been benchmarked against the Azure prebuilt receipt model.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_OCR_MODEL=mistral-ocr-4-0
MISTRAL_OCR_COST_PER_PAGE_USD=0.004

# Server-side product enrichment. Use an identifying contact URL or email per Open Food Facts guidance.
OPEN_FOOD_FACTS_USER_AGENT=NoFridgeSpoil/1.0 (https://your-app.example/support)
